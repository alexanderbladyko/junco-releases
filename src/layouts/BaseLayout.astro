---
import '../styles/global.css';
import { getLocale, localizedPath, locales, type Locale } from '../i18n';
import { useTranslations } from '../i18n/locales';

interface Props {
  title: string;
  description?: string;
  active?: 'home' | 'docs';
  locale?: Locale;
}

const {
  title,
  description = 'Junco keeps your everyday work light, clear, and close at hand.',
  active = 'home',
  locale = getLocale(Astro.url.pathname)
}: Props = Astro.props;
const t = useTranslations(locale)

const languageLinks = locales
  .filter((item) => item !== locale)
  .map((item) => ({
    locale: item,
    label: t('languageName'),
    href: localizedPath(Astro.url.pathname, item as Locale)
  }));
---

<!doctype html>
<html lang={locale} class="bg-zinc-200 text-zinc-800">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
    <title>Junco / {title}</title>
  </head>
  <body class="min-h-screen bg-zinc-200 text-zinc-800 antialiased">
    <header class="page-shell flex items-center justify-between py-6">
      <a class="group inline-flex items-center gap-2 text-xl font-extrabold tracking-tight text-zinc-800" href={localizedPath('/', locale)}>
        <img src="/favicon.svg" alt="" class="w-16 h-16"/>
        junco
      </a>
      <nav class="flex items-center gap-3 text-xl font-medium text-zinc-500" aria-label={t('navLabel')}>
        <a class:list={{ 'rounded-lg px-3 py-2 text-zinc-800': active === 'home', 'px-3 py-2 hover:text-zinc-800': active !== 'home' }} href={localizedPath('/', locale)}>{t('home')}</a>
        <a class:list={{ 'rounded-lg px-3 py-2 text-zinc-800': active === 'docs', 'px-3 py-2 hover:text-zinc-800': active !== 'docs' }} href={localizedPath('/docs', locale)}>{t('docs')}</a>
        {languageLinks.map((item) => <a class="rounded-lg px-3 py-2 hover:bg-zinc-300 hover:text-zinc-800" href={item.href} lang={item.locale}>{item.label}</a>)}
      </nav>
    </header>
    <main><slot /></main>
    <footer class="page-shell flex items-center justify-between border-t border-zinc-300 py-8 text-xl text-zinc-500">
      <span class="tracking-widest">junco / 2026</span>
    </footer>
  </body>
</html>
