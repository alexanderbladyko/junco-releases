---
import { getCollection, type CollectionEntry } from 'astro:content';
import DocPage from '../../../components/DocPage.astro';
import { docSlug, type Locale } from '../../../i18n';

export async function getStaticPaths() {
  const entries: CollectionEntry<'docs'>[] = await getCollection('docs');

  return entries
    .filter((entry) => entry.data.locale !== 'en')
    .map((entry) => ({
      params: { locale: entry.data.locale, slug: docSlug(entry.id) },
      props: { locale: entry.data.locale, entry }
    }));
}

const { locale, entry } = Astro.props as {
  locale: Locale;
  entry: CollectionEntry<'docs'>;
};
---

<DocPage locale={locale} entry={entry} />
