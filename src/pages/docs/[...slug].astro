---
import { getCollection, type CollectionEntry } from 'astro:content';
import DocPage from '../../components/DocPage.astro';
import { defaultLocale, docSlug } from '../../i18n';

export async function getStaticPaths() {
  const allEntries: CollectionEntry<'docs'>[] = await getCollection('docs');
  const entries = allEntries.filter((entry) => entry.data.locale === defaultLocale);

  return entries.map((entry) => ({
    params: { slug: docSlug(entry.id) },
    props: { entry }
  }));
}

const { entry } = Astro.props;
---

<DocPage locale="en" entry={entry} />
